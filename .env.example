# Server-only — data access via the service-role key (never exposed to the browser).
# Copy these from the driver-context-manager/.env file.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Public — used by the browser/SSR auth client only (the publishable key is the public key).
# NEXT_PUBLIC_SUPABASE_URL is the same value as SUPABASE_URL.
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY is the project's publishable key (`sb_publishable_…`, Supabase dashboard →
# Project Settings → API keys). The legacy anon JWT still works here but is being retired.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
